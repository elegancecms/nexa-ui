{
  "name": "@khaimerax/nexa-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight, zero-dependency React UI component library",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "publish:cli": "cd packages/cli && npm publish --access public",
    "publish:core": "cd packages/core && npm publish --access public",
    "publish:button": "cd packages/button && npm publish --access public",
    "publish:all": "npm run publish:cli"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@9.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/elegancecms/nexa-ui.git"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwind",
    "typescript",
    "zero-dependencies",
    "lightweight"
  ],
  "license": "MIT"
}

